# Shopify store (Admin + Storefront)
# VITE_SHOPIFY_STORE_DOMAIN = full host, e.g. your-store.myshopify.com
# SHOPIFY_SHOP = subdomain only, e.g. your-store
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_SHOP=your-store
VITE_SHOPIFY_API_VERSION=2025-01
# Newsletter signup uses Storefront `customerEmailMarketingSubscribe` on the
# `unstable` API version (token needs unauthenticated_write_customers).

# Storefront API — public token is safe for Vite / browser
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_access_token
# Private token is server-only — never prefix with VITE_
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_storefront_access_token

# Dev Dashboard app credentials (server/scripts only — never prefix with VITE_)
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_or_automation_token

# Google Tag Manager + GA4 (see docs/ANALYTICS.md + docs/RAILWAY_CUTOVER.md)
# GitHub Pages demo:
VITE_GTM_ID=GTM-PQSG4NXT
VITE_GA4_MEASUREMENT_ID=G-ET6SXZWE8E
VITE_GA4_SEND_DIRECT=true
# Live cutover (Railway website service):
# VITE_GTM_ID=GTM-PPTR6V3B
# VITE_GA4_MEASUREMENT_ID=G-YKOBBOTPM4
# VITE_BASE_PATH=/

# Contact + reviews API (Railway / local Node server — see server/README.md)
# Same host serves POST /contact and GET|POST /reviews (reviews need DATABASE_URL).
# Production builds fall back to the Railway URL if this is unset.
# Server-side contact email uses Resend FREE plan (RESEND_API_KEY on contact-api),
# not browser env — see server/.env.example and server/README.md.
VITE_CONTACT_API_URL=http://localhost:3001
# Production Railway:
# VITE_CONTACT_API_URL=https://contact-api-production-9af6.up.railway.app
# Optional; must match CONTACT_API_KEY on the server if set
VITE_CONTACT_API_KEY=

# QR generation (scripts/generate-product-review-qrs.mjs)
# Writes PNGs + print-sheet.html under output/product-review-qrs/
# SITE_URL=https://www.sundayrollsgolf.com
# SITE_BASE_PATH=/
# Staging / GitHub Pages:
# SITE_URL=https://sunday-rolls.github.io/website
# SITE_BASE_PATH=/website
# HEADCOVERS_ONLY=0
