{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && VITE_BASE_PATH=/website/ vite build && VITE_BASE_PATH=/website/ VITE_SITE_ORIGIN=https://sunday-rolls.github.io node scripts/emit-spa-shells.mjs",
    "build:pages": "tsc -b && vite build && node scripts/emit-spa-shells.mjs",
    "build:railway": "tsc -b && VITE_BASE_PATH=/ vite build && node scripts/emit-spa-shells.mjs",
    "start:spa": "node scripts/serve-spa.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "catalog:sync": "python3 scripts/sync-product-catalog.py",
    "catalog:port-shopify": "node scripts/port-catalog-to-shopify.mjs",
    "assets:scrape": "python3 scripts/scrape-sundayrolls-assets.py",
    "reviews:scrape": "node scripts/scrape-etsy-reviews.mjs",
    "reviews:tag-handles": "node scripts/tag-review-product-handles.mjs",
    "reviews:qr": "node scripts/generate-product-review-qrs.mjs",
    "reviews:qr:pages": "SITE_TARGET=pages node scripts/generate-product-review-qrs.mjs",
    "reviews:qr:live": "SITE_TARGET=live node scripts/generate-product-review-qrs.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
