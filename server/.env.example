PORT=3001

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://sunday-rolls.github.io

# Reject POSTs without an allowlisted Origin/Referer (set false only for local curl tests)
REQUIRE_BROWSER_ORIGIN=true

# Optional shared secret; if set, requests must send header X-Contact-Key
CONTACT_API_KEY=

# Where contact form emails are delivered
CONTACT_TO_EMAIL=sundayrollsdevops@gmail.com

# Gmail SMTP (use an App Password, not the account login password)
SMTP_USER=sundayrollsdevops@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
