PORT=3001

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://sunday-rolls.github.io

# Reject POSTs without an allowlisted Origin/Referer (set false only for local curl tests)
REQUIRE_BROWSER_ORIGIN=true

# Optional shared secret; if set, requests must send header X-Contact-Key
CONTACT_API_KEY=

# Where contact form emails are delivered
CONTACT_TO_EMAIL=sundayrollsdevops@gmail.com

# Gmail SMTP (use an App Password, not the account login password)
SMTP_USER=sundayrollsdevops@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Postgres (reviews + analytics dashboard)
DATABASE_URL=postgres://user:pass@localhost:5432/sundayrolls

# --- Analytics dashboard (/dashboard) ---
DASHBOARD_ENABLED=true
# Set true behind HTTPS (Railway)
DASHBOARD_SECURE_COOKIES=false
# Bootstrap Sam/Alex/Derick on boot with this password (dev only). Prefer user:set-password in prod.
DASHBOARD_DEMO_PASSWORD=
# Optional override: email:Name,email:Name
DASHBOARD_BOOTSTRAP_USERS=stwolfe10@gmail.com:Sam,funk20alex@gmail.com:Alex,derickkuchera04@gmail.com:Derick
# Load mockup-shaped sample metrics on boot (local/demo)
ANALYTICS_SEED_DEMO_ON_BOOT=false
# Allow POST /dashboard/api/seed-demo when authenticated
ANALYTICS_ALLOW_DEMO_SEED=false
# Hard cutover date YYYY-MM-DD (Squarespace before, Shopify after)
WEBSITE_CUTOVER_AT=

# Live GA4 sync (service account JSON as a single-line string)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric resource, e.g. properties/513898453 (not the G- measurement id)
GA4_PROPERTY_RESOURCE=
GA4_SYNC_ON_BOOT=false
GA4_SYNC_DAYS=90
# Search Console property URL the service account can read (trailing slash)
SEARCH_CONSOLE_SITE_URL=https://www.sundayrollsgolf.com/

# Sales Tracker on Google Drive (share Viewer with the service account)
# Spreadsheet: https://docs.google.com/spreadsheets/d/1v18ftrLt5jcyGJsKFq37CwIYYY04aKIDeeEp0F5_XMU
SALES_TRACKER_DRIVE_FILE_ID=1v18ftrLt5jcyGJsKFq37CwIYYY04aKIDeeEp0F5_XMU
# Optional folder to browse in the dashboard Data page
SALES_TRACKER_DRIVE_FOLDER_ID=

# Shopify Admin (Dev Dashboard app — client_credentials mint short-lived tokens)
SHOPIFY_SHOP=chrgrk-ff
SHOPIFY_STORE_DOMAIN=chrgrk-ff.myshopify.com
SHOPIFY_API_VERSION=2025-01
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional CLI automation token (not used for Admin API pulls)
SHOPIFY_ADMIN_ACCESS_TOKEN=
